{
  "name": "dollar-shell",
  "description": "Run OS and shell commands using template tag functions. Same API in Node, Deno, and Bun. Web streams, TypeScript typings, zero dependencies.",
  "version": "1.3.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node/index.js",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "tape6 --flags FO",
    "test:bun": "tape6-bun --flags FO",
    "test:deno": "tape6-deno --flags FO",
    "test:seq": "tape6-seq --flags FO",
    "test:seq:bun": "bun run `tape6-seq --self` --flags FO",
    "test:seq:deno": "deno run -A `tape6-seq --self` --flags FO",
    "ts-check": "tsc --noEmit",
    "js-check": "tsc --project tsconfig.check.json",
    "ts-test": "tape6 --flags FO 'tests/test-*.*ts'",
    "ts-test:bun": "tape6-bun --flags FO 'tests/test-*.*ts'",
    "ts-test:deno": "tape6-deno --flags FO 'tests/test-*.*ts'",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write ."
  },
  "files": [
    "/src",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uhop/dollar-shell.git"
  },
  "bugs": {
    "url": "https://github.com/uhop/dollar-shell/issues"
  },
  "homepage": "https://github.com/uhop/dollar-shell#readme",
  "keywords": [
    "shell",
    "spawn",
    "subprocess",
    "dollar",
    "stream",
    "process",
    "exec",
    "command",
    "web-streams",
    "node-streams",
    "template-tag",
    "pipeline",
    "capture",
    "abort-signal",
    "typescript",
    "esm",
    "cross-runtime",
    "zero-dependency",
    "nodejs",
    "deno",
    "bun"
  ],
  "author": "Eugene Lazutkin <eugene.lazutkin@gmail.com> (http://www.lazutkin.com/)",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/uhop"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "tape-six": "^1.15.0",
    "typescript": "^7.0.2"
  },
  "tape6": {
    "tests": [
      "/tests/test-*.*js"
    ]
  }
}
